# Copy to .env for local runs. On Render, set these in the dashboard instead.
API_KEY=pick-a-long-random-secret
PAGES_JSON={"<page_id>": {"name": "TheFabjunk", "token": "<long-lived page token>"}}
LLM_API_KEY=<openai-or-compatible-api-key>
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
